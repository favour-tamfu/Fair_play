{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artist_shares.schema.json",
  "title": "GET /api/v1/artist-shares (c-1.3): what each artist truly earned, as a share (no money, D-015)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "period": {
      "enum": [
        "live",
        "mock_month",
        "all"
      ]
    },
    "mode": {
      "enum": [
        "standardised",
        "raw"
      ]
    },
    "stats_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "rule_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "frozen": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "artist_name": {
            "type": "string"
          },
          "share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.000001
          },
          "n_songs": {
            "type": "integer",
            "minimum": 1
          },
          "raw_plays": {
            "type": "integer",
            "minimum": 0
          },
          "counted_plays": {
            "type": "number",
            "minimum": 0
          },
          "songs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "song_id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "share": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "raw_plays": {
                  "type": "integer",
                  "minimum": 0
                },
                "counted_plays": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "song_id",
                "title",
                "share",
                "raw_plays",
                "counted_plays"
              ]
            }
          }
        },
        "required": [
          "rank",
          "artist_name",
          "share",
          "n_songs",
          "raw_plays",
          "counted_plays",
          "songs"
        ]
      }
    }
  },
  "required": [
    "period",
    "mode",
    "stats_run_id",
    "rule_version",
    "frozen",
    "rules",
    "rows"
  ]
}
