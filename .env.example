# Copy to .env (never commit .env). docker compose reads it automatically.
POSTGRES_USER=fairplay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fairplay
# Host-side tools/tests reach the db through the published port 55432 (localhost only)
DATABASE_URL=postgresql://fairplay:change-me@127.0.0.1:55432/fairplay
# B-T15 (stretch) only — Sepolia testnet, never mainnet:
# SEPOLIA_RPC_URL=
# ANCHOR_PRIVATE_KEY=
