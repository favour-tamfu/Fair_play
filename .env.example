# Copy to .env (never commit .env). docker compose reads it automatically.
POSTGRES_USER=fairplay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fairplay
# Host-side tools/tests reach the db through the published port 55432 (localhost only)
DATABASE_URL=postgresql://fairplay:change-me@127.0.0.1:55432/fairplay
# Admin actions need header X-Admin-Token with this value (make your own: python -c "import secrets; print(secrets.token_urlsafe(24))")
ADMIN_TOKEN=change-me-too
# 0 = API only (dashboard pages off), 1 = pages on
SERVE_WEB=1
# Ports on this computer (change only if 8000 / 55432 are taken)
API_PORT=8000
DB_PORT=55432
# Optional: demo_seed also checks the number of catalogue songs (0 = any number, at least 1)
CATALOGUE_SIZE=0
# B-T15 (stretch, not built) — Sepolia testnet, never mainnet:
# SEPOLIA_RPC_URL=
# ANCHOR_PRIVATE_KEY=
